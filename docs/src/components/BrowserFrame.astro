---
import type { Screenshot } from "../lib/screenshots";

interface Props {
  shot: Screenshot;
  eager?: boolean;
  class?: string;
}
const { shot, eager = false, class: className = "" } = Astro.props;
---

<div class={`overflow-hidden rounded-xl bg-ink-800 shadow-2xl ring-1 ring-ink-900/10 dark:ring-white/10 ${className}`}>
  <div class="flex items-center gap-1.5 bg-ink-800 px-3 py-2" aria-hidden="true">
    <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
    <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
    <span class="size-2.5 rounded-full bg-[#28c840]"></span>
    <span class="ml-3 truncate rounded-md bg-ink-700 px-3 py-0.5 text-[0.7rem] text-ink-300">touchline{shot.route}</span>
  </div>
  <img src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} loading={eager ? "eager" : "lazy"} decoding="async" class="block h-auto w-full" />
</div>
