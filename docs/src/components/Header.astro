---
import ThemeToggle from "./ThemeToggle.astro";
import { REPO_URL, url } from "../lib/site";

interface Props {
  current?: "home" | "play" | "technical";
  showMenuButton?: boolean;
}
const { current, showMenuButton = false } = Astro.props;
const links = [
  { key: "play", label: "Player guide", href: url("docs/play/") },
  { key: "technical", label: "Engineering", href: url("docs/technical/") },
];
---

<header class="sticky top-0 z-40 border-b border-ink-900/5 bg-white/80 backdrop-blur-xl dark:border-white/5 dark:bg-ink-950/80">
  <a href="#main" class="sr-only z-50 rounded-md bg-pitch-600 px-3 py-2 text-white focus:not-sr-only focus:absolute focus:left-3 focus:top-3">Skip to content</a>
  <div class="mx-auto flex h-16 max-w-[90rem] items-center gap-3 px-4 sm:px-6">
    {
      showMenuButton && (
        <button
          type="button"
          data-sidebar-toggle
          aria-controls="docs-sidebar"
          aria-expanded="false"
          class="inline-flex size-9 items-center justify-center rounded-lg text-ink-600 hover:bg-ink-100 lg:hidden dark:text-ink-300 dark:hover:bg-ink-800"
        >
          <span class="sr-only">Open navigation</span>
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
      )
    }
    <a href={url()} class="flex items-center gap-2.5 font-display text-lg font-bold tracking-tight text-ink-900 dark:text-white" aria-current={current === "home" ? "page" : undefined}>
      <img src={url("touchline.svg")} alt="" width="32" height="32" class="size-8" />
      Touchline
    </a>
    <nav aria-label="Main" class="ml-6 hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={current === link.key ? "page" : undefined}
            class="rounded-lg px-3 py-2 text-sm font-semibold text-ink-600 hover:bg-ink-100 hover:text-ink-900 aria-[current=page]:text-pitch-700 dark:text-ink-300 dark:hover:bg-ink-800 dark:hover:text-white dark:aria-[current=page]:text-pitch-300"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex items-center gap-1 sm:gap-2">
      <button
        type="button"
        data-search-open
        aria-keyshortcuts="Control+K Meta+K /"
        class="flex h-9 items-center gap-2 rounded-lg border border-ink-200 bg-white px-2.5 text-sm text-ink-500 shadow-sm hover:border-pitch-500 hover:text-ink-900 sm:w-56 lg:w-72 dark:border-ink-700 dark:bg-ink-900 dark:text-ink-300 dark:hover:text-white"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span class="hidden sm:inline">Search docs</span><span class="sr-only sm:hidden">Search docs</span>
        <kbd class="ml-auto hidden rounded border border-ink-200 px-1.5 font-sans text-xs font-semibold sm:inline dark:border-ink-700">Ctrl K</kbd>
      </button>
      <ThemeToggle />
      <a
        href={REPO_URL}
        class="inline-flex size-9 items-center justify-center rounded-lg text-ink-500 hover:bg-ink-100 hover:text-ink-900 dark:text-ink-300 dark:hover:bg-ink-800 dark:hover:text-white"
      >
        <span class="sr-only">Touchline on GitHub</span>
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.4-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z" /></svg>
      </a>
    </div>
  </div>
</header>
