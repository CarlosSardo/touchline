---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import Toc from "../components/Toc.astro";
import Mermaid from "../components/Mermaid.astro";
import { getNavigation, getReadingOrder, SECTIONS, type SectionKey } from "../lib/docs";
import { REPO_BRANCH, REPO_URL } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  section: SectionKey;
  headings?: MarkdownHeading[];
  sourcePath?: string;
}
const { title, description, section, headings = [], sourcePath } = Astro.props;
const sections = await getNavigation();
const order = await getReadingOrder();
const norm = (h: string) => (h.endsWith("/") ? h : `${h}/`);
const here = norm(Astro.url.pathname);
const index = order.findIndex((p) => norm(p.href) === here);
const prev = index > 0 ? order[index - 1] : undefined;
const next = index >= 0 && index < order.length - 1 ? order[index + 1] : undefined;
const sectionLabel = SECTIONS[section].label;
const editUrl = sourcePath ? `${REPO_URL}/edit/${REPO_BRANCH}/${sourcePath}` : undefined;
---

<BaseLayout title={title} description={description} current={section === "other" ? undefined : section} showMenuButton>
  <div class="mx-auto flex max-w-[90rem] px-4 sm:px-6">
    <div data-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-ink-950/50 backdrop-blur-sm lg:hidden"></div>
    <aside
      id="docs-sidebar"
      data-sidebar
      aria-label="Documentation navigation"
      class="fixed inset-y-0 left-0 z-40 hidden w-72 overflow-y-auto overscroll-contain bg-white px-5 pb-10 pt-6 shadow-2xl data-[open]:block lg:sticky lg:top-16 lg:z-0 lg:block lg:h-[calc(100dvh-4rem)] lg:w-64 lg:shrink-0 lg:bg-transparent lg:px-0 lg:pr-6 lg:pt-8 lg:shadow-none xl:w-72 dark:bg-ink-900 lg:dark:bg-transparent"
      data-pagefind-ignore
    >
      <div class="mb-6 flex items-center justify-between lg:hidden">
        <span class="font-display font-bold">Navigation</span>
        <button type="button" data-sidebar-close class="inline-flex size-9 items-center justify-center rounded-lg hover:bg-ink-100 dark:hover:bg-ink-800">
          <span class="sr-only">Close navigation</span>
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
      </div>
      <Sidebar sections={sections} currentHref={Astro.url.pathname} />
    </aside>

    <main id="main" class="min-w-0 flex-1 py-8 lg:pl-10 xl:pr-10">
      <article data-pagefind-body data-pagefind-filter={`section:${sectionLabel}`} data-pagefind-meta={`title:${title}`}>
        <p class="mb-2 text-sm font-semibold text-pitch-600 dark:text-pitch-400" data-pagefind-ignore>{sectionLabel}</p>
        <h1 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl dark:text-white">{title}</h1>
        {description && <p class="mt-3 text-lg text-ink-500 dark:text-ink-300">{description}</p>}
        <div class="prose-touchline mt-8">
          <slot />
        </div>
      </article>

      <div class="mt-16 flex flex-col gap-6 border-t border-ink-200 pt-8 dark:border-ink-800" data-pagefind-ignore>
        <nav aria-label="Previous and next pages" class="grid gap-4 sm:grid-cols-2">
          {
            prev ? (
              <a href={prev.href} rel="prev" class="group rounded-xl border border-ink-200 p-4 hover:border-pitch-500 dark:border-ink-800">
                <span class="text-xs font-semibold uppercase tracking-wider text-ink-400">← Previous</span>
                <span class="mt-1 block font-semibold text-ink-900 group-hover:text-pitch-700 dark:text-white dark:group-hover:text-pitch-300">{prev.label}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a href={next.href} rel="next" class="group rounded-xl border border-ink-200 p-4 text-right hover:border-pitch-500 dark:border-ink-800">
                <span class="text-xs font-semibold uppercase tracking-wider text-ink-400">Next →</span>
                <span class="mt-1 block font-semibold text-ink-900 group-hover:text-pitch-700 dark:text-white dark:group-hover:text-pitch-300">{next.label}</span>
              </a>
            )
          }
        </nav>
        {editUrl && (
          <a href={editUrl} class="text-sm text-ink-500 hover:text-pitch-600 dark:text-ink-400">Edit this page on GitHub</a>
        )}
      </div>
    </main>

    <aside class="hidden w-56 shrink-0 xl:block" aria-label="Table of contents" data-pagefind-ignore>
      <div class="sticky top-16 max-h-[calc(100dvh-4rem)] overflow-y-auto py-8">
        <Toc headings={headings} />
      </div>
    </aside>
  </div>
  <Mermaid />
</BaseLayout>

<script>
  const sidebar = document.querySelector<HTMLElement>("[data-sidebar]");
  const backdrop = document.querySelector<HTMLElement>("[data-sidebar-backdrop]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-sidebar-toggle]");
  const close = document.querySelector<HTMLButtonElement>("[data-sidebar-close]");
  const setOpen = (open: boolean) => {
    if (!sidebar || !toggle) return;
    sidebar.toggleAttribute("data-open", open);
    backdrop?.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("overflow-hidden", open);
    if (open) (sidebar.querySelector("[aria-current=page]") as HTMLElement | null ?? close)?.focus();
    else toggle.focus();
  };
  toggle?.addEventListener("click", () => setOpen(true));
  close?.addEventListener("click", () => setOpen(false));
  backdrop?.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && sidebar?.hasAttribute("data-open")) setOpen(false);
  });
  matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
    if (e.matches && sidebar?.hasAttribute("data-open")) setOpen(false);
  });
  const currentLink = sidebar?.querySelector<HTMLElement>("[aria-current=page]");
  if (sidebar && currentLink) sidebar.scrollTop = Math.max(0, currentLink.offsetTop - sidebar.clientHeight / 2);
</script>
