---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}
const headings = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  headings.length > 1 && (
    <nav aria-labelledby="toc-heading" class="text-sm" data-toc>
      <p id="toc-heading" class="mb-3 font-display text-xs font-bold uppercase tracking-wider text-ink-400">
        On this page
      </p>
      <ul class="space-y-1.5">
        {headings.map((h) => (
          <li class={h.depth === 3 ? "pl-3" : ""}>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class="block text-ink-500 hover:text-ink-900 data-[active]:font-semibold data-[active]:text-pitch-700 dark:text-ink-400 dark:hover:text-white dark:data-[active]:text-pitch-300"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
  if (links.length && "IntersectionObserver" in window) {
    const targets = links.map((a) => document.getElementById(a.dataset.tocLink!)).filter(Boolean) as HTMLElement[];
    const visible = new Set<string>();
    const update = () => {
      const first = targets.find((t) => visible.has(t.id));
      if (!first) return;
      links.forEach((a) => a.toggleAttribute("data-active", a.dataset.tocLink === first.id));
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id);
        update();
      },
      { rootMargin: "-80px 0px -60% 0px" },
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>
