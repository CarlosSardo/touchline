---
const base = import.meta.env.BASE_URL;
---

<dialog
  id="search-dialog"
  data-base={base}
  aria-labelledby="search-dialog-title"
  class="m-0 h-dvh max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-ink-950/60 backdrop:backdrop-blur-sm sm:mx-auto sm:mt-[10vh] sm:h-auto sm:max-w-2xl sm:px-4"
>
  <div class="flex h-full flex-col overflow-hidden bg-white shadow-2xl ring-1 ring-ink-900/10 sm:h-auto sm:max-h-[75vh] sm:rounded-2xl dark:bg-ink-900 dark:ring-white/10">
    <h2 id="search-dialog-title" class="sr-only">Search the Touchline docs</h2>
    <form role="search" class="flex items-center gap-3 border-b border-ink-100 px-4 dark:border-ink-800" onsubmit="return false">
      <svg class="size-5 shrink-0 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <label for="search-input" class="sr-only">Search</label>
      <input
        id="search-input"
        type="search"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
        aria-describedby="search-status"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search transfers, scouting, GBE, architecture…"
        class="h-14 min-w-0 flex-1 bg-transparent text-base text-ink-900 outline-none placeholder:text-ink-400 dark:text-white [&::-webkit-search-cancel-button]:hidden"
      />
      <button
        type="button"
        data-search-close
        class="rounded-md border border-ink-200 px-2 py-1 text-xs font-semibold text-ink-500 hover:bg-ink-50 dark:border-ink-700 dark:text-ink-300 dark:hover:bg-ink-800"
      >
        Esc<span class="sr-only"> – close search</span>
      </button>
    </form>
    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain p-2">
      <p id="search-status" role="status" aria-live="polite" class="px-3 py-8 text-center text-sm text-ink-500 dark:text-ink-300">
        Type to search the player guide and engineering docs.
      </p>
      <ul id="search-results" role="listbox" aria-label="Search results" class="space-y-1"></ul>
    </div>
    <div class="hidden items-center gap-4 border-t border-ink-100 px-4 py-2 text-xs text-ink-400 sm:flex dark:border-ink-800">
      <span><kbd class="font-sans font-semibold">↑</kbd> <kbd class="font-sans font-semibold">↓</kbd> to navigate</span>
      <span><kbd class="font-sans font-semibold">Enter</kbd> to open</span>
      <span><kbd class="font-sans font-semibold">Esc</kbd> to close</span>
      <span class="ml-auto">Search by Pagefind</span>
    </div>
  </div>
</dialog>

<script>
  type PagefindResult = {
    url: string;
    excerpt: string;
    meta: { title?: string };
    filters?: Record<string, string[]>;
    sub_results?: { title: string; url: string; excerpt: string }[];
  };
  type Pagefind = {
    options: (o: Record<string, unknown>) => Promise<void>;
    init: () => Promise<void>;
    debouncedSearch: (q: string, o?: object, ms?: number) => Promise<{ results: { data: () => Promise<PagefindResult> }[] } | null>;
  };

  const dialog = document.getElementById("search-dialog") as HTMLDialogElement;
  const input = document.getElementById("search-input") as HTMLInputElement;
  const status = document.getElementById("search-status") as HTMLElement;
  const list = document.getElementById("search-results") as HTMLUListElement;
  const base = dialog.dataset.base ?? "/";
  let pagefind: Promise<Pagefind> | undefined;
  let active = -1;
  let opener: Element | null = null;

  const loadPagefind = () =>
    (pagefind ??= (async () => {
      const path = `${base}pagefind/pagefind.js`;
      const pf = (await import(/* @vite-ignore */ path)) as Pagefind;
      await pf.options({ baseUrl: base, excerptLength: 22 });
      await pf.init();
      return pf;
    })());

  const setStatus = (text: string, visible = true) => {
    status.textContent = text;
    status.classList.toggle("sr-only", !visible);
  };

  const options = () => [...list.querySelectorAll<HTMLAnchorElement>("[role=option]")];

  const setActive = (index: number) => {
    const all = options();
    if (!all.length) return;
    active = (index + all.length) % all.length;
    all.forEach((el, i) => el.setAttribute("aria-selected", String(i === active)));
    const current = all[active];
    input.setAttribute("aria-activedescendant", current.id);
    current.scrollIntoView({ block: "nearest" });
  };

  const optionClass =
    "group block rounded-xl px-3 py-3 text-ink-700 outline-none hover:bg-pitch-50 aria-selected:bg-pitch-50 aria-selected:ring-2 aria-selected:ring-pitch-500 dark:text-ink-200 dark:hover:bg-ink-800 dark:aria-selected:bg-ink-800";

  const render = (results: PagefindResult[], query: string) => {
    list.replaceChildren();
    active = -1;
    input.removeAttribute("aria-activedescendant");
    if (!results.length) {
      input.setAttribute("aria-expanded", "false");
      setStatus(`No results for “${query}”. Try a broader word such as “transfer”, “youth” or “finance”.`);
      return;
    }
    let n = 0;
    for (const result of results) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = result.url;
      a.id = `search-option-${n++}`;
      a.setAttribute("role", "option");
      a.setAttribute("aria-selected", "false");
      a.className = optionClass;
      const head = document.createElement("div");
      head.className = "flex items-center gap-2";
      const title = document.createElement("span");
      title.className = "font-semibold text-ink-900 dark:text-white";
      title.textContent = result.meta.title ?? result.url;
      head.append(title);
      const section = result.filters?.section?.[0];
      if (section) {
        const badge = document.createElement("span");
        badge.className = "rounded-full bg-pitch-100 px-2 py-0.5 text-[0.7rem] font-semibold text-pitch-800 dark:bg-pitch-900 dark:text-pitch-200";
        badge.textContent = section;
        head.append(badge);
      }
      const excerpt = document.createElement("p");
      excerpt.className = "mt-1 line-clamp-2 text-sm text-ink-500 dark:text-ink-300 [&_mark]:bg-amber-accent/40 [&_mark]:text-inherit";
      excerpt.innerHTML = result.excerpt; // Pagefind escapes page text; only <mark> is added.
      a.append(head, excerpt);
      li.append(a);
      const subs = (result.sub_results ?? []).filter((s) => s.url !== result.url && s.title !== result.meta.title).slice(0, 2);
      if (subs.length) {
        const ul = document.createElement("ul");
        ul.className = "ml-4 border-l border-ink-100 pl-2 dark:border-ink-800";
        for (const sub of subs) {
          const subLi = document.createElement("li");
          const subA = document.createElement("a");
          subA.href = sub.url;
          subA.id = `search-option-${n++}`;
          subA.setAttribute("role", "option");
          subA.setAttribute("aria-selected", "false");
          subA.className = `${optionClass} py-2 text-sm`;
          subA.textContent = `↳ ${sub.title}`;
          subLi.append(subA);
          ul.append(subLi);
        }
        li.append(ul);
      }
      list.append(li);
    }
    input.setAttribute("aria-expanded", "true");
    setStatus(`${results.length} result${results.length === 1 ? "" : "s"} for “${query}”.`, false);
  };

  const search = async () => {
    const query = input.value.trim();
    if (!query) {
      list.replaceChildren();
      input.setAttribute("aria-expanded", "false");
      setStatus("Type to search the player guide and engineering docs.");
      return;
    }
    try {
      const pf = await loadPagefind();
      const response = await pf.debouncedSearch(query, {}, 150);
      if (!response || input.value.trim() !== query) return;
      render(await Promise.all(response.results.slice(0, 8).map((r) => r.data())), query);
    } catch (error) {
      console.error(error);
      pagefind = undefined;
      list.replaceChildren();
      input.setAttribute("aria-expanded", "false");
      setStatus(
        import.meta.env.DEV
          ? "Search index not found. The index is built with the site: run `npm run build && npm run preview` in website/."
          : "Search is unavailable right now. Please reload the page or browse the sidebar.",
      );
    }
  };

  const open = () => {
    if (dialog.open) return;
    opener = document.activeElement;
    dialog.showModal();
    input.focus();
    input.select();
    void loadPagefind().catch(() => undefined);
    if (input.value.trim()) void search();
  };

  dialog.addEventListener("close", () => {
    if (opener instanceof HTMLElement) opener.focus();
  });
  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog.querySelector("[data-search-close]")?.addEventListener("click", () => dialog.close());
  input.addEventListener("input", () => void search());
  input.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown") {
      event.preventDefault();
      setActive(active + 1);
    } else if (event.key === "ArrowUp") {
      event.preventDefault();
      setActive(active - 1);
    } else if (event.key === "Enter") {
      const target = options()[active] ?? options()[0];
      if (target) {
        event.preventDefault();
        window.location.href = target.href;
      }
    }
  });
  document.querySelectorAll("[data-search-open]").forEach((button) => button.addEventListener("click", open));
  document.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement | null;
    const typing = !!target && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName));
    if ((event.key === "k" || event.key === "K") && (event.metaKey || event.ctrlKey)) {
      event.preventDefault();
      if (dialog.open) dialog.close();
      else open();
    } else if (event.key === "/" && !typing && !dialog.open) {
      event.preventDefault();
      open();
    }
  });
</script>
