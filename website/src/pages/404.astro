---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../lib/site";
---

<BaseLayout title="Page not found">
  <main id="main" class="mx-auto flex max-w-xl flex-col items-center px-4 py-32 text-center" data-pagefind-ignore>
    <p class="font-display text-7xl font-extrabold text-pitch-600">404</p>
    <h1 class="mt-4 font-display text-3xl font-bold text-ink-900 dark:text-white">Offside! That page isn't here.</h1>
    <p class="mt-3 text-ink-500 dark:text-ink-300">It may have moved. Try the search or head back to the start.</p>
    <div class="mt-8 flex gap-3">
      <a href={url()} class="rounded-xl bg-pitch-600 px-5 py-2.5 font-semibold text-white hover:bg-pitch-700">Home</a>
      <button type="button" data-search-open class="rounded-xl border border-ink-300 px-5 py-2.5 font-semibold hover:border-pitch-500 dark:border-ink-700">Search</button>
    </div>
  </main>
</BaseLayout>
