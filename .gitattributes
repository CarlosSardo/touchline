# Squad: union merge for append-only team state files
.squad/decisions.md merge=union
.squad/agents/*/history.md merge=union
.squad/log/** merge=union
.squad/orchestration-log/** merge=union
.squad/rai/audit-trail.md merge=union
.squad/fact-checker/audit-trail.md merge=union

# Dagger SDK code generated by `dagger generate` (committed, as Dagger 1.0 requires)
.dagger/modules/*/clients/** linguist-generated=true
.dagger/modules/*/__dagger.dispatch.ts linguist-generated=true
.dagger/modules/*/entrypoint/** linguist-generated=true
dagger.lock linguist-generated=true
