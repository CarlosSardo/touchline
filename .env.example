# Local SQL Server Developer only. Replace the empty password placeholder.
# Use a unique strong password; quote values containing # or $ with single quotes.
SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=touchline
SQL_USER=sa
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_SCHEMA=dbo

# Verification always selects isolated schemas and enables all SQL suites.
# Remote tests require BOTH explicit opt-in and the exact SQL_DATABASE value.
SQL_ALLOW_REMOTE_TESTS=false
SQL_TEST_DATABASE=

# Host development stays loopback-only. The image defaults to 0.0.0.0:3001
# and intentionally refuses startup without genuine hosted authentication.
API_HOST=127.0.0.1
API_PORT=3001

AZURE_SUBSCRIPTION_ID=3373ab04-1dd1-49b2-8884-3094cfd0ca06
AZURE_TENANT_ID=d588edc8-06a0-47ac-a9e6-aea06d1c6c25
AZURE_LOCATION=swedencentral
AZURE_RESOURCE_GROUP=rg-touchline
AZURE_SQL_SERVER=touchline-3373ab04
AZURE_SQL_DATABASE=touchline
AZURE_SQL_CONNECTION_TYPE=Redirect
AZURE_APP=touchline
GHCR_IMAGE=ghcr.io/carlossardo/touchline
GHCR_USER=CarlosSardo
GHCR_TOKEN=
GHCR_PULL_TOKEN=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Azure SQL: set SQL_SERVER=touchline-3373ab04.database.windows.net,
# clear BOTH SQL_USER and SQL_PASSWORD, and set SQL_TRUST_SERVER_CERTIFICATE=false.
# Use Azure CLI identity locally or managed identity in the hosted app, with
# SQL permissions provisioned separately. The local sa login is not Azure auth.
# Hosted owner authentication and deployment are configured by separate scripts.