# Copy to .env (never commit it) and fill in the empty values. Quote values containing # or $ with single quotes.
# The same file serves `docker compose` on the Raspberry Pi and host development (`npm run dev`).

# --- PostgreSQL 18 (compose service "postgres") ---
# Superuser "postgres": administration and backups only. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# App login role, created as the owner of SQL_DATABASE when the database volume is first initialized.
SQL_DATABASE=touchline
SQL_USER=touchline
SQL_PASSWORD=
# Host development reaches compose PostgreSQL on loopback; inside compose the app always uses SQL_HOST=postgres.
SQL_HOST=127.0.0.1
SQL_PORT=5432
# disable for loopback/compose; verify-full is required for any remote host.
SQL_SSL=disable
# Optional: SQL_POOL_SIZE=10, SQL_REQUEST_TIMEOUT_MS=120000, SQL_SCHEMA=public (local no-auth world).
# Loopback port that compose publishes PostgreSQL on (never exposed to the LAN).
POSTGRES_PUBLISH_PORT=5432

# Verification always selects isolated schemas and enables all SQL suites.
# Remote tests require BOTH explicit opt-in and the exact SQL_DATABASE value.
SQL_ALLOW_REMOTE_TESTS=false
SQL_TEST_DATABASE=

# --- App server ---
# Host development stays loopback-only. The image listens on 0.0.0.0:3001 inside its container and
# refuses startup without genuine authentication (REQUIRE_AUTH=true and the OIDC settings below).
API_HOST=127.0.0.1
API_PORT=3001

# --- Raspberry Pi deployment (docker compose) ---
# Image to run; pin a digest from the image workflow for reproducible upgrades.
TOUCHLINE_IMAGE=ghcr.io/carlossardo/touchline:latest
# Host address/port of the app. Keep 127.0.0.1 behind the Caddy https profile or another reverse proxy.
TOUCHLINE_BIND=127.0.0.1
TOUCHLINE_PORT=3001
# Public hostname for the https profile (DNS must point at this host; ports 80/443 reachable).
TOUCHLINE_DOMAIN=
# Node heap cap for the app container (limit 2 GB).
TOUCHLINE_NODE_OPTIONS=--max-old-space-size=1536
# scripts/pi-backup.sh defaults.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14

# --- Sign-in (in-app OpenID Connect; Microsoft personal accounts by default) ---
# Required by the compose deployment (the app refuses a non-loopback binding without sign-in); local
# development runs without it. Uncomment and fill in on the Pi. Unset optional values stay commented:
# an empty value counts as set. Register a web app at https://entra.microsoft.com (personal Microsoft
# accounts) with the redirect URI https://<TOUCHLINE_DOMAIN>/auth/callback.
# REQUIRE_AUTH=true
# APP_ORIGIN=https://touchline.example.com
# OIDC_ISSUER=https://login.microsoftonline.com/9188040d-6c67-4c5b-b112-36a304b66dad/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Signs the session cookie; must differ from INVITE_SIGNING_SECRET. Generate with: openssl rand -base64 48
# SESSION_SECRET=
# Hops of trusted reverse proxies (1 = Caddy or one host proxy in front of the app).
# TRUST_PROXY=1
# Optional organization tenant whose owner/allow-listed object IDs may also sign in.
# AUTH_HOME_TENANT_ID=
# OWNER_OBJECT_ID=
# ALLOWED_USER_OBJECT_IDS=

# --- Invite access ---
# Players request an invite at /invite; the approver reviews it at /admin/invites while signed in.
# Locally EMAIL_TRANSPORT defaults to log (links printed to the API console); hosted it defaults to gmail.
# APPROVER_EMAIL=approver@example.com
# OWNER_EMAIL=owner@outlook.com
MAX_PLAYERS=10
# Database-size guard before accepting or claiming invites (sized for the Pi's SSD).
INVITE_DB_SIZE_LIMIT_GB=24
# HMAC secret for signed review/resend links (required when hosted). Generate with: openssl rand -base64 48
# INVITE_SIGNING_SECRET=
# gmail or disabled when hosted; log for local development.
# EMAIL_TRANSPORT=gmail
# Gmail SMTP: Google Account > Security > 2-Step Verification > App passwords.
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=Touchline <you@gmail.com>
